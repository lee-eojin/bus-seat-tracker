{
  "name": "bus-seat-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "collect": "npm run build && node dist/bus-seat-collector/collector.js",
    "build:data": "npm run build && node dist/prototype-bus/build-data.js",
    "backtest": "npm run build && node dist/backtest/backtest.js",
    "score": "npm run build && node dist/backtest/score-predictions.js",
    "queue": "npm run build && node dist/backtest/queue-recovery.js",
    "test": "npm run build && node --test dist/",
    "budget": "npm run build && node scripts/call-budget.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
